# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA DE GESTÃO EMPRESARIAL INTEGRADO
# ==============================================================================

# Conexão com o PostgreSQL Serverless (Supabase / Neon DB Free Tier ou Local)
#
# No Supabase:
# 1. Acesse: Project Settings -> Database -> Connection string
# 2. Em "Transaction" (Connection pooling): copie para DATABASE_URL
# 3. Em "Session" (Direct connection): copie para DIRECT_URL
#
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# Segredo de Sessão e Criptografia (Mínimo de 32 caracteres de alta entropia)
# Gere um segredo seguro para produção (ex: rodando `openssl rand -base64 32`)
SESSION_SECRET="altere-para-um-segredo-de-producao-super-seguro-com-min-32-chars"

# Ambiente de Execução
NODE_ENV="production"
